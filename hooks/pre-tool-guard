#!/usr/bin/env bash
# PreToolUse guard: turn three skill laws into hard gates at the harness level.
# The Node engine owns JSON parsing and all policy checks. Invalid input or a
# broken engine returns a deny payload so the host receives a decision.
set -uo pipefail

deny() {
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$1"
  exit 0
}

if ! command -v node >/dev/null 2>&1; then
  deny "dmj guard: Node.js is required to evaluate PreToolUse input; install Node.js and retry."
fi

JS_ENGINE="$(cd "$(dirname "$0")" && pwd)/pre-tool-guard.js"
if [ ! -f "$JS_ENGINE" ]; then
  deny "dmj guard: guard engine file missing (pre-tool-guard.js). Restore the dmj plugin file."
fi

node "$JS_ENGINE" 2>/dev/null
ENGINE_EXIT=$?
if [ "$ENGINE_EXIT" -ne 0 ]; then
  deny "dmj guard: guard engine failed; restore the dmj plugin and retry."
fi
exit 0
