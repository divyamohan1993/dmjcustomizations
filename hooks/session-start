#!/usr/bin/env bash
# SessionStart hook for dmjcustomizations: injects the using-dmjcustomizations
# meta-skill so every session starts with the skill-routing rules loaded.
# Adapted from obra/superpowers (MIT).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

content=$(cat "${PLUGIN_ROOT}/skills/using-dmjcustomizations/SKILL.md" 2>&1 || echo "Error reading using-dmjcustomizations skill")

# Escape string for JSON embedding using bash parameter substitution
# (single C-level pass per substitution; fast even for large skills).
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$content")
session_context="<EXTREMELY_IMPORTANT>\nYou have dmjcustomizations.\n\n**Below is your 'dmjcustomizations:using-dmjcustomizations' skill - how to find and use skills. For all other skills, use the 'Skill' tool:**\n\n${escaped}\n</EXTREMELY_IMPORTANT>"

# printf instead of heredoc: works around bash 5.3+ heredoc hang
# (see obra/superpowers#571).
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0
