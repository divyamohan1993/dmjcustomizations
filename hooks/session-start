#!/usr/bin/env bash
# SessionStart hook for dmj: injects the using-dmj
# meta-skill so every session starts with the skill-routing rules loaded,
# plus a throttled (24h) update check against the GitHub repo.
# Adapted from obra/superpowers (MIT).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

content=$(cat "${PLUGIN_ROOT}/skills/using-dmj/SKILL.md" 2>&1 || echo "Error reading using-dmj skill")

# --- Update check: at most once per 24h, every failure silent, never blocks boot ---
update_notice=""
check_update() {
    command -v curl >/dev/null 2>&1 || return 0
    local data_dir="${CLAUDE_PLUGIN_DATA:-$HOME/.claude/plugins/data/dmj}"
    mkdir -p "$data_dir" 2>/dev/null || return 0
    local stamp="$data_dir/update-check-stamp"
    local now epoch_last
    now=$(date +%s)
    epoch_last=$(cat "$stamp" 2>/dev/null || echo 0)
    [ $((now - epoch_last)) -lt 86400 ] && return 0
    echo "$now" > "$stamp" 2>/dev/null || true
    local local_v remote_v newest
    local_v=$(grep -o '"version"[^,]*' "${PLUGIN_ROOT}/.claude-plugin/plugin.json" 2>/dev/null | head -1 | grep -o '[0-9][0-9.]*' || echo "")
    remote_v=$(curl -fsS --max-time 4 "https://raw.githubusercontent.com/divyamohan1993/dmjcustomizations/main/.claude-plugin/plugin.json" 2>/dev/null | grep -o '"version"[^,]*' | head -1 | grep -o '[0-9][0-9.]*' || echo "")
    [ -n "$local_v" ] && [ -n "$remote_v" ] || return 0
    [ "$local_v" = "$remote_v" ] && return 0
    newest=$(printf '%s\n%s\n' "$local_v" "$remote_v" | sort -V | tail -1)
    if [ "$newest" = "$remote_v" ]; then
        update_notice="\n\n<dmj-update>dmj ${remote_v} is available (installed: ${local_v}). Tell the user, and offer to run for them: claude plugin marketplace update dmj && claude plugin update dmj@dmj (restart applies it).</dmj-update>"
    fi
    return 0
}
check_update || true

# Escape string for JSON embedding using bash parameter substitution
# (single C-level pass per substitution; fast even for large skills).
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$content")
session_context="<dmj>\nYou have dmj. The routing skill below is pre-loaded; invoke every other skill via the 'Skill' tool.\n\n${escaped}\n</dmj>${update_notice}"

# printf instead of heredoc: works around bash 5.3+ heredoc hang
# (see obra/superpowers#571).
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0
