#!/bin/sh
# humanize pre-push gate. Checks ONLY the prose in the commits being PUSHED
# (reads the ref list on stdin), so it never bricks a push over old files.
# Blocks unicode dashes (always) and AI-tell phrases (gate mode). Bypass once:
# HUMANIZE_SKIP=1 git push (logged loudly). Chains husky/lefthook and any native
# pre-push. Degrades to a dash-only BYTE check when Node is unavailable; the
# byte form works on any POSIX grep (BSD, busybox), because `grep -P` errors
# outside GNU and an erroring check would wave the push through green.
if [ "${HUMANIZE_SKIP:-}" = "1" ]; then
  echo "humanize: GATE BYPASSED via HUMANIZE_SKIP=1 (prose not checked)." >&2
  exit 0
fi
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SELF="$HOOK_DIR/$(basename -- "$0")"
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo .)
ZERO="0000000000000000000000000000000000000000"
EMPTY="4b825dc642cb6eb9a060e54bf8d69288fbee4904"  # git empty-tree object

# Collect prose files in the commits being pushed (stdin lines: local_ref local_sha remote_ref remote_sha).
FILES=""
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$ZERO" ] && continue                      # branch deletion
  if [ "$rsha" = "$ZERO" ]; then                         # new branch: only genuinely new commits
    newc=$(git rev-list "$lsha" --not --remotes 2>/dev/null)
    if [ -n "$newc" ]; then
      oldest=$(printf '%s\n' "$newc" | tail -n1)
      if git rev-parse -q --verify "${oldest}^" >/dev/null 2>&1; then base="${oldest}^"; else base="$EMPTY"; fi
    else base="$EMPTY"; fi
  else
    base="$rsha"
  fi
  NEW=$(git diff --name-only -z --diff-filter=ACM "$base" "$lsha" 2>/dev/null | tr '\0' '\n' | grep -Ei '\.(md|mdx|markdown|txt)$')
  FILES=$(printf '%s\n%s\n' "$FILES" "$NEW")
done
FILES=$(printf '%s\n' "$FILES" | sed '/^[[:space:]]*$/d' | sort -u)

GUARD=""
for c in "$ROOT/.humanize/humanize-guard.mjs" "$HOOK_DIR/humanize-guard.mjs" "$HOOK_DIR/../humanize-guard.mjs"; do
  [ -f "$c" ] && { GUARD="$c"; break; }
done

if [ -n "$FILES" ]; then
  if command -v node >/dev/null 2>&1 && [ -n "$GUARD" ]; then
    # NUL-delimit so filenames with spaces are not split (gate evasion otherwise).
    ( cd "$ROOT" && printf '%s\n' "$FILES" | tr '\n' '\0' | xargs -0 node "$GUARD" --gate ) || exit 1
  else
    # UTF-8 byte sequences: U+2010..U+2015 = e2 80 90..95, U+2212 = e2 88 92.
    # LC_ALL=C makes grep match raw bytes; plain BRE, no -P, portable everywhere.
    DASH_A=$(printf '\342\200[\220-\225]')
    DASH_B=$(printf '\342\210\222')
    if printf '%s\n' "$FILES" | while IFS= read -r f; do
        [ -f "$ROOT/$f" ] || continue
        LC_ALL=C grep -q -e "$DASH_A" -e "$DASH_B" "$ROOT/$f" 2>/dev/null && echo HIT
      done | grep -q HIT; then
      echo "humanize: unicode dash in pushed prose (Node missing, dash-only check). Blocked."
      exit 1
    fi
  fi
fi

# Chain existing repo hooks so husky/lefthook/native pre-push still run; never call ourselves.
for H in "$ROOT/.husky/pre-push" "$ROOT/.git/hooks/pre-push.local" "$ROOT/.git/hooks/pre-push"; do
  [ -x "$H" ] || continue
  case "$H" in "$SELF") continue ;; esac
  "$H" "$@" || exit 1
done
exit 0
